DATABASE_URL=postgresql://localhost:5432/scaffold_local
AUTH_ISSUER=https://identity.example.invalid/
AUTH_AUDIENCE=scaffold-api
AUTH_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
PORT=4100
WEB_ORIGIN=http://localhost:3000
SHUTDOWN_TIMEOUT_MS=8000
MAX_IN_FLIGHT=100
RATE_LIMIT=100
RATE_WINDOW_MS=60000
LIMITER_MODE=memory
# LIMITER_REDIS_URL=rediss://redis.example.invalid:6379
# LIMITER_NAMESPACE=my-api-production
# TRUST_PROXY_CIDRS= explicit verified proxy IPs/CIDRs only
AUTH_JWKS_COOLDOWN_MS=30000
AUTH_JWKS_CACHE_MS=600000
# none (default) keeps stdout pure JSON logs; otlp sends traces/metrics to OTEL_EXPORTER_OTLP_ENDPOINT;
# console prints raw spans for local debugging only (not JSON).
TELEMETRY_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
