API_BASE_URL=http://127.0.0.1:4100
# external-cookie preserves an existing integration; oidc opts into the library-backed server-session profile.
AUTH_MODE=external-cookie
# AUTH_APP_ORIGIN=https://app.example.invalid
# AUTH_ISSUER=https://identity.example.invalid
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_SCOPE=openid
# AUTH_REDIS_URL=rediss://redis.example.invalid:6379
# AUTH_NAMESPACE=my-web-production
# AUTH_SESSION_SECONDS=3600
# DEPLOYMENT_REPLICAS=1
# APP_DEPLOYMENT_ID=release-id
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY= supplied by secret manager at build time
# Optional: use an approved collector; omit to disable remote trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=api-backed-web
# Local development only: allow http: origin, issuer and Redis when all three are loopback.
# AUTH_INSECURE_LOOPBACK=true
# SHUTDOWN_TIMEOUT_MS=8000
