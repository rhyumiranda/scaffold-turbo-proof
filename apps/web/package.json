{
  "name": "@repo/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/package.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "node scripts/typegen.mjs && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && pnpm check:arch",
    "check:arch": "node scripts/check-architecture.mjs",
    "test:unit": "node --test scripts/architecture.test.mjs scripts/telemetry.test.mjs scripts/budget.test.mjs scripts/integration.test.mjs scripts/install-policy.test.mjs scripts/security.test.mjs scripts/load.test.mjs scripts/deployment.test.mjs scripts/trace-export.test.mjs scripts/return-to.test.mjs scripts/runtime-config.test.mjs",
    "test:identity": "node --test scripts/identity.test.mjs",
    "test:identity:browser": "node scripts/run-integration.mjs --identity",
    "test:telemetry": "node scripts/run-integration.mjs --identity --telemetry",
    "test:replicas": "node scripts/run-integration.mjs --identity --replicas",
    "test:container": "node scripts/check-container.mjs",
    "test:load": "node scripts/load.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "test:runtime": "node --test scripts/runtime.test.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "secretlint '**/*'",
    "test": "playwright test"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@redis/client": "catalog:",
    "@vercel/otel": "2.1.3",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "@repo/api-client": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "catalog:",
    "jose": "catalog:",
    "secretlint": "catalog:",
    "typescript": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  },
  "type": "module"
}
