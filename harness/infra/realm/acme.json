{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "clients": [
    {
      "clientId": "acme-web",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_ACME_WEB_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3101/auth/callback",
        "http://localhost:3102/auth/callback",
        "http://localhost:3103/auth/callback",
        "http://localhost:3104/auth/callback",
        "http://localhost:3105/auth/callback",
        "http://localhost:3106/auth/callback",
        "http://localhost:3107/auth/callback",
        "http://localhost:3108/auth/callback",
        "http://localhost:3109/auth/callback",
        "http://localhost:3110/auth/callback",
        "https://app.acme.test:8443/auth/callback",
        "http://localhost:3000/auth/callback",
        "http://localhost:3100/auth/callback",
        "http://127.0.0.1:3100/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3101/*##http://localhost:3102/*##http://localhost:3103/*##http://localhost:3104/*##http://localhost:3105/*##http://localhost:3106/*##http://localhost:3107/*##http://localhost:3108/*##http://localhost:3109/*##http://localhost:3110/*##https://app.acme.test:8443/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "acme-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "acme-cli",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_ACME_CLI_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "acme-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "acme-noaud",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_ACME_NOAUD_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
