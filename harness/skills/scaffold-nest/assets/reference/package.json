{
  "name": "nest-reference",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "contract": "node scripts/export-contract.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:runtime",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:secrets": "secretlint '**/*'",
    "check:docs": "node scripts/check-docs.mjs",
    "contract:check": "node --test test/contracts.test.mjs",
    "contract:compat": "node scripts/check-contract.mjs",
    "test:unit": "node --test test/*.unit.test.mjs scripts/load.test.mjs",
    "test:integration": "node --import ./test/test-database.mjs --test --test-concurrency=1 test/api.test.mjs test/migrations.test.mjs test/identity.test.mjs",
    "test:profiles": "node --import ./test/test-database.mjs --test --test-concurrency=1 test/limiter.test.mjs test/limiter-http.test.mjs",
    "test:recovery": "node scripts/recovery.mjs",
    "test:telemetry": "node --import ./test/test-database.mjs --test test/telemetry.test.mjs",
    "test:container": "node scripts/check-container.mjs",
    "test:load": "node scripts/load.mjs",
    "test:runtime": "node --import ./test/test-database.mjs --test --test-concurrency=1 test/runtime.test.mjs test/harness.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@redis/client": "6.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "secretlint": "13.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
